http:
  middlewares:
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true
    cors-headers:
      headers:
        accessControlAllowOriginList:
          - "*"  # Permitir todas as origens temporariamente para debugging
        accessControlAllowMethods:
          - GET
          - POST
          - PUT
          - DELETE
          - OPTIONS
        accessControlAllowHeaders:
          - "*"
        accessControlAllowCredentials: true
        accessControlMaxAge: 100
        addVaryHeader: true

  routers:
    # Roteador para API
    api:
      rule: "Host(`nexiosdigital.com`, `www.nexiosdigital.com`) && PathPrefix(`/api`)"
      service: "nexiosdigital-backend"
      entryPoints:
        - "websecure"
      tls: {}
      middlewares:
        - "cors-headers"
      priority: 100
    
    # Roteador para WebSockets
    websockets:
      rule: "Host(`nexiosdigital.com`, `www.nexiosdigital.com`) && PathPrefix(`/ws`)"
      service: "nexiosdigital-backend"
      entryPoints:
        - "websecure"
      tls: {}
      middlewares:
        - "cors-headers"
      priority: 100
  
    # Roteador para redirecionamento HTTP para HTTPS
    http-catchall:
      rule: "hostregexp(`{host:.+}`)"
      service: "noop@internal"
      entryPoints:
        - "web"
      middlewares:
        - "https-redirect"
      priority: 1